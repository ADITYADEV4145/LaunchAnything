{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "priority",
    "channels",
    "envKeys",
    "mcpAliases"
  ],
  "properties": {
    "id": {
      "enum": [
        "postiz",
        "buffer",
        "ayrshare",
        "github-release",
        "devto",
        "email",
        "manual"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "priority": {
      "type": "integer",
      "minimum": 0
    },
    "channels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "envKeys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z_][A-Z0-9_]*$"
      }
    },
    "mcpAliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  }
}
