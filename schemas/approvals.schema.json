{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launch-liftoff.dev/schemas/approvals.schema.json",
  "type": "object",
  "properties": {
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "channel": {
            "enum": [
              "show-hn",
              "product-hunt",
              "x",
              "linkedin",
              "reddit",
              "devto",
              "indie-hackers",
              "github-release",
              "tiktok",
              "reels",
              "shorts",
              "instagram",
              "email",
              "blog",
              "press-release"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "channel",
          "name",
          "time",
          "hash"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "approvals"
  ],
  "additionalProperties": false
}
