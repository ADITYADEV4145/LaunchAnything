  "properties": {
    "name": {"type": "string"}, "description": {"type": "string"},
    "logoUrl": {"type": "string"}, "iconUrl": {"type": "string"}, "ogImage": {"type": "string"},
    "colors": {"type": "array", "items": {"type": "string"}},
    "fonts": {"type": "array", "items": {"type": "string"}}
  }
}
