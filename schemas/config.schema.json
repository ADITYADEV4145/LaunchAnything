{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launch-liftoff.dev/schemas/config.schema.json",
  "type": "object",
  "properties": {
    "releaseChannels": { "type": "array", "uniqueItems": true, "items": { "enum": ["x", "linkedin", "email", "devto"] } },
    "xApiCost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": ["number", "null"], "minimum": 0 },
        "withUrl": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "accounts": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "profile": {
      "enum": [
        "devtool",
        "indie-saas",
        "b2b-saas",
        "consumer-mobile",
        "enterprise"
      ]
    },
    "launchType": {
      "enum": [
        "new-product",
        "feature",
        "changelog",
        "relaunch"
      ]
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "minItems": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "launchDate": {
      "type": "string",
      "format": "date"
    },
    "brandKit": {
      "type": "string",
      "minLength": 1
    },
    "approvers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "redact": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "profileConfirmed": {
      "type": "boolean"
    },
    "proof": {
      "type": "object",
      "properties": {
        "benchmarks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "repos": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "results": {
                "type": "string",
                "minLength": 1
              },
              "metrics": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "metric": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pointer": {
                      "type": "string"
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "context": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "metric",
                    "pointer",
                    "unit",
                    "context"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "name",
              "results",
              "metrics"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "benchmarks"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "profile",
    "launchType",
    "channels",
    "timezone",
    "launchDate",
    "profileConfirmed"
  ],
  "additionalProperties": false
}
