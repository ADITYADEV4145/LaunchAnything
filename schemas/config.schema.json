{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launch-liftoff.dev/schemas/config.schema.json",
  "type": "object",
  "properties": {
    "profile": {
      "enum": [
        "devtool",
        "indie-saas",
        "b2b-saas",
        "consumer-mobile",
        "enterprise"
      ]
    },
    "launchType": {
      "enum": [
        "new-product",
        "feature",
        "changelog",
        "relaunch"
      ]
    },
    "channels": {
      "type": "array",
      "items": {
        "enum": [
          "show-hn",
          "product-hunt",
          "x",
          "linkedin",
          "reddit",
          "devto",
          "indie-hackers",
          "github-release",
          "tiktok",
          "reels",
          "shorts",
          "instagram",
          "email",
          "blog",
          "press-release"
        ]
      },
      "minItems": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "launchDate": {
      "type": "string",
      "format": "date"
    },
    "brandKit": {
      "type": "string",
      "minLength": 1
    },
    "approvers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "redact": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "profileConfirmed": {
      "type": "boolean"
    }
  },
  "required": [
    "profile",
    "launchType",
    "channels",
    "timezone",
    "launchDate",
    "profileConfirmed"
  ],
  "additionalProperties": false
}
