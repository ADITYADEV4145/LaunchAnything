{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launch-liftoff.dev/schemas/history.schema.json",
  "type": "object",
  "properties": {
    "profiles": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "devtool",
          "indie-saas",
          "b2b-saas",
          "consumer-mobile",
          "enterprise"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "time": {
              "type": "string",
              "format": "date-time"
            },
            "channel": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "lesson": {
              "type": "string",
              "minLength": 1
            },
            "bestHour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23
            }
          },
          "required": [
            "time",
            "channel",
            "lesson"
          ],
          "additionalProperties": false
        },
        "minItems": 0
      }
    }
  },
  "required": [
    "profiles"
  ],
  "additionalProperties": false
}
