{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "idea",
    "pains",
    "competitors"
  ],
  "properties": {
    "idea": {
      "type": "string",
      "minLength": 1
    },
    "pains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "mentions",
          "intensity",
          "date_range",
          "quotes",
          "current_tools",
          "shortcomings"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "mentions": {
            "type": "integer",
            "minimum": 3
          },
          "intensity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "date_range": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "string",
                "format": "date"
              },
              "end": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "quotes": {
            "type": "array",
            "minItems": 3,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "url"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                }
              }
            }
          },
          "current_tools": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "shortcomings": {
            "type": "string",
            "minLength": 1
          },
          "solution_feature": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "what_they_do",
          "complaints"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "what_they_do": {
            "type": "string",
            "minLength": 1
          },
          "complaints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
