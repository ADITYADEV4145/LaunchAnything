{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launch-liftoff.dev/schemas/post.schema.json",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "slot"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "link": {
      "type": "string",
      "format": "uri"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 3
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "proof": {
            "type": "string",
            "minLength": 1
          },
          "pain": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ]
          }
        },
        "minProperties": 2,
        "maxProperties": 2
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "title": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hook": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "picked": {
      "enum": [
        1,
        2
      ]
    }
  },
  "required": [
    "title",
    "body",
    "media",
    "claims"
  ],
  "additionalProperties": false
}
