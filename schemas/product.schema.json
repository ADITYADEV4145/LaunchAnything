{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launch-liftoff.dev/schemas/product.schema.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "oneLiner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "audience": {
      "type": "object",
      "properties": {
        "who": {
          "type": "string",
          "minLength": 1
        },
        "where": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "who"
      ],
      "additionalProperties": false
    },
    "problem": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "pains": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "pain_index": {
                "type": "integer",
                "minimum": 0
              },
              "quotes": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "text",
                    "url"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "name",
              "pain_index",
              "quotes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "summary"
      ],
      "additionalProperties": false
    },
    "proofPoints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 3,
      "maxItems": 5
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "file",
                    "commit",
                    "url"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "ref"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "name",
          "description",
          "sources"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "file",
                    "commit",
                    "url"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "ref"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "text",
          "sources"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "proof": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "anyOf": [{ "type": "number" }, { "type": "string" }]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "minLength": 1
          },
          "source_file": {
            "type": "string",
            "minLength": 1
          },
          "source_pointer": {
            "type": "string",
            "pattern": "^(?:/(?:[^~]|~[01])*)*$"
          }
        },
        "required": [
          "metric",
          "value",
          "unit",
          "context",
          "source_file",
          "source_pointer"
        ],
        "additionalProperties": false
      }
    },
    "money_moment": {
      "type": "object",
      "properties": {
        "before": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "before",
        "action",
        "after"
      ],
      "additionalProperties": false
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "dislikes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "name",
          "url",
          "dislikes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "oneLiner",
    "audience",
    "problem",
    "proofPoints",
    "features",
    "claims",
    "proof",
    "money_moment"
  ],
  "additionalProperties": false
}
