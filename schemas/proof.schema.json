{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "benchmark": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "ran",
        "recorded"
      ]
    },
    "command": {
      "type": [
        "string",
        "null"
      ]
    },
    "repo": {
      "type": [
        "string",
        "null"
      ]
    },
    "ranAt": {
      "type": "string",
      "format": "date-time"
    },
    "exitCode": {
      "type": "integer"
    },
    "results_file": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "results": {},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "anyOf": [{ "type": "number" }, { "type": "string" }]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "minLength": 1
          },
          "source_file": {
            "type": "string",
            "minLength": 1
          },
          "source_pointer": {
            "type": "string",
            "pattern": "^(?:/(?:[^~]|~[01])*)*$"
          }
        },
        "required": [
          "metric",
          "value",
          "unit",
          "context",
          "source_file",
          "source_pointer"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "benchmark",
    "mode",
    "command",
    "repo",
    "ranAt",
    "exitCode",
    "results_file",
    "sha256",
    "results",
    "metrics"
  ],
  "additionalProperties": false
}
