{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launch-liftoff.dev/schemas/published.schema.json",
  "type": "object",
  "properties": {
    "posts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "status": {
            "enum": [
              "manual",
              "scheduled",
              "published",
              "live",
              "failed",
              "cancelled"
            ]
          },
          "scheduledAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "channel",
          "id",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "posts"
  ],
  "additionalProperties": false
}
