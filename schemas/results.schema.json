{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launch-liftoff.dev/schemas/results.schema.json",
  "type": "object",
  "properties": {
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "channel": {
            "enum": [
              "show-hn",
              "product-hunt",
              "x",
              "linkedin",
              "reddit",
              "devto",
              "indie-hackers",
              "github-release",
              "tiktok",
              "reels",
              "shorts",
              "instagram",
              "email",
              "blog",
              "press-release"
            ]
          },
          "views": {
            "type": "integer",
            "minimum": 0
          },
          "likes": {
            "type": "integer",
            "minimum": 0
          },
          "comments": {
            "type": "integer",
            "minimum": 0
          },
          "clicks": {
            "type": "integer",
            "minimum": 0
          },
          "starsDelta": {
            "type": "integer"
          },
          "signups": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "channel"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "observedAt",
    "channels"
  ],
  "additionalProperties": false
}
