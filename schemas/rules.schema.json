{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launch-liftoff.dev/schemas/rules.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "profile"
        },
        "id": {
          "enum": [
            "devtool",
            "indie-saas",
            "b2b-saas",
            "consumer-mobile",
            "enterprise"
          ]
        },
        "defaultChannels": {
          "type": "array",
          "items": {
            "enum": [
              "show-hn",
              "product-hunt",
              "x",
              "linkedin",
              "reddit",
              "devto",
              "indie-hackers",
              "github-release",
              "tiktok",
              "reels",
              "shorts",
              "instagram",
              "email",
              "blog",
              "press-release"
            ]
          },
          "minItems": 1
        },
        "tone": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id",
        "defaultChannels",
        "tone"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "channel"
        },
        "id": {
          "enum": [
            "show-hn",
            "product-hunt",
            "x",
            "linkedin",
            "reddit",
            "devto",
            "indie-hackers",
            "github-release",
            "tiktok",
            "reels",
            "shorts",
            "instagram",
            "email",
            "blog",
            "press-release"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "profiles": {
          "type": "array",
          "items": {
            "enum": [
              "devtool",
              "indie-saas",
              "b2b-saas",
              "consumer-mobile",
              "enterprise"
            ]
          },
          "minItems": 1
        },
        "bestPostingTimes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "minItems": 1
        },
        "bestPostingDays": {
          "type": "array",
          "items": {
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          },
          "minItems": 1
        },
        "leadTimeDays": {
          "type": "integer",
          "minimum": 0
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "lastVerified": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "kind",
        "id",
        "name",
        "profiles",
        "bestPostingTimes",
        "bestPostingDays",
        "leadTimeDays",
        "version",
        "lastVerified"
      ],
      "additionalProperties": false
    }
  ]
}
