{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launch-liftoff.dev/schemas/shots.schema.json",
  "type": "object",
  "properties": {
    "baseUrl": { "type": "string" },
    "startCommand": { "type": "string" },
    "readyTimeoutMs": { "type": "integer", "minimum": 1 },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sources": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "purpose": { "enum": ["hook", "before", "action", "after", "proof", "cta"] },
          "caption": { "type": "string", "pattern": "^\\s*(?:\\S+\\s+){0,11}\\S*\\s*$" },
          "claim": { "type": "string", "minLength": 1 },
          "moneyMoment": { "type": "boolean" },
          "element": { "type": "string", "minLength": 1 },
          "highlight": {
            "oneOf": [
              { "type": "object", "properties": { "selector": { "type": "string", "minLength": 1 } }, "required": ["selector"], "additionalProperties": false },
              { "type": "object", "properties": { "text": { "type": "string", "minLength": 1 } }, "required": ["text"], "additionalProperties": false },
              { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }, "required": ["x", "y", "width", "height"], "additionalProperties": false }
            ]
          },
          "themes": { "type": "array", "items": { "enum": ["light", "dark"] }, "minItems": 1, "uniqueItems": true },
          "deviceScale": { "type": "number", "minimum": 1, "maximum": 3, "default": 2 },
          "setup": { "type": "array", "items": { "type": "string" } },
          "card": { "type": "boolean" },
          "fontSize": { "type": "integer", "minimum": 1, "default": 32 },
          "cols": { "type": "integer", "minimum": 1 },
          "rows": { "type": "integer", "minimum": 1 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "commands": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "fullPage": { "type": "boolean" },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "viewport": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "click",
                    "type",
                    "wait"
                  ]
                },
                "selector": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "selector"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "waitFor": {
            "type": "string",
            "minLength": 1
          },
          "theme": {
            "enum": [
              "light",
              "dark"
            ]
          },
          "record": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "viewport"
        ],
        "anyOf": [{ "required": ["route"] }, { "required": ["commands"] }, { "required": ["card"], "properties": { "card": { "const": true } } }],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "shots"
  ],
  "additionalProperties": false
}
