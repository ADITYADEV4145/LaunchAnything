{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launch-liftoff.dev/schemas/video-script.schema.json",
  "type": "object",
  "properties": {
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shot": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+(?:\\s+\\S+){0,11}$"
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "role": { "enum": ["hook", "before", "action", "after", "proof", "cta"] },
          "shortDuration": { "type": "number", "exclusiveMinimum": 0 },
          "highlight": { "type": "object", "properties": { "x": {"type":"number", "minimum":0}, "y": {"type":"number", "minimum":0}, "width": {"type":"number", "exclusiveMinimum":0}, "height": {"type":"number", "exclusiveMinimum":0} }, "required": ["x", "y", "width", "height"], "additionalProperties": false },
          "voiceover": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "shot",
          "text",
          "duration"
        ],
        "additionalProperties": false
      },
      "minItems": 4,
      "maxItems": 10
    }
  },
  "required": [
    "scenes"
  ],
  "allOf": [{
    "if": { "properties": { "scenes": { "contains": { "required": ["role"] } } } },
    "else": { "properties": { "scenes": { "minItems": 6, "items": { "properties": { "text": { "pattern": "^\\S+(?:\\s+\\S+){0,7}$" } } } } } }
  }],
  "additionalProperties": false
}
